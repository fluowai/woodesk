# ==============================================================================
# Dockerfile.saas - Build Seguro para Distribuição Whitelabel
# ==============================================================================
# Este Dockerfile é desenhado para remover o código fonte (TypeScript) do
# container final, servindo apenas os artefatos compilados (.next/standalone)
# Isso impede que revendas apaguem facilmente o middleware de checagem da licença.

FROM node:22-alpine AS base

FROM base AS builder
WORKDIR /app
RUN npm install -g pnpm@9.15.9

# Copia dependências
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copia o código fonte inteiro
COPY . .

# Faz o build (gera o diretório .next/standalone, que só contém o essencial)
# A variável STANDALONE=true garante que next.config.mjs gere esse output
ENV NEXT_PRIVATE_STANDALONE=true
RUN pnpm build

# ------------------------------------------------------------------------------
# Imagem Final: Distribuída aos revendedores
# ------------------------------------------------------------------------------
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# O usuário node padrão, sem root.
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copiamos APENAS a pasta public e o artefato standalone. O código original fica para trás.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

# O server.js foi gerado pelo output: 'standalone' do Next.js
CMD ["node", "server.js"]
